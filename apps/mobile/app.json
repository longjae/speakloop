{
  "expo": {
    "name": "SpeakLoop",
    "slug": "speakloop",
    "scheme": "com.speakloop.app",
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "microphonePermission": "SpeakLoop에서 말하기 연습을 녹음하려면 마이크 접근이 필요합니다."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.speakloop.app",
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C0E0F"
      }
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5d726a38-6ab6-4e58-bf9d-5dcc6be36958"
      }
    },
    "owner": "tinkit-studio",
    "updates": {
      "url": "https://u.expo.dev/5d726a38-6ab6-4e58-bf9d-5dcc6be36958"
    },
    "icon": "./assets/icon.png"
  }
}
